{
  "description": "Flag the terminal when Claude needs input; clear it when you respond or Claude finishes",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cni.sh", "args": ["notify"] }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cni.sh", "args": ["clear"] }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cni.sh", "args": ["clear"] }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cni.sh", "args": ["done"] }] }
    ]
  }
}
